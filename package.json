{
  "name": "chuka-personal-site",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:worker": "wrangler dev --config wrangler.jsonc",
    "deploy": "node scripts/deploy-production.mjs",
    "deploy:preview": "node scripts/deploy-production.mjs --preview",
    "deploy:enable-indexing": "node scripts/deploy-production.mjs --enable-indexing",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/worker.test.mjs",
    "lint": "node --check worker/index.mjs && node --check scripts/deploy-production.mjs && node --check src/data/routes.js && node --check src/scripts/site.js && node --check src/scripts/sheet.js",
    "diff-check": "git diff --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "libphonenumber-js": "^1.13.14",
    "three": "^0.186.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  }
}
