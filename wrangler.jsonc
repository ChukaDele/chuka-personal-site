{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuka-personal-site",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": { "ALLOW_INDEXING": "false" }
}
