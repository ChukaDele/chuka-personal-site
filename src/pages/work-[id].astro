---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import Part from '../components/Part.astro';
import Note from '../components/Note.astro';
import End from '../components/End.astro';
import Pic from '../components/Pic.astro';
import { works, ring } from '../data/works.js';
export function getStaticPaths() { return works.map((w, i) => ({ params: { id: w.id }, props: { w, next: works[(i + 1) % works.length] } })); }
const { w, next } = Astro.props;
// what the foot of each case asks: the role it suggests, or the kind of work it shows
const ask = { etap: ['Hiring for operations?', 'hiring'], 'surface-talent': ['Hiring for operations?', 'hiring'] }[w.id] || ['Have something like this?', 'project'];
---
<Base title={`${w.name} · Chuka Dele-Oyeleru`} current="Work">
  <Plate word={w.name} still={w.shot || undefined} frame alt={w.shot ? (w.shotNote || `A screen from ${w.name}.`) : ''} credit={w.shot ? (w.shotNote || `${w.name}, as shipped.`) : ''}>
    <p class="label">{w.kind} · {w.where}</p>
    <h1>{w.title}</h1>
    <dl class="creds"><dt>Role</dt><dd>{w.roleFull || w.role}</dd><dt>When</dt><dd>{w.when}</dd><dt>Scope</dt><dd>{w.scope}</dd>{w.honour && <Fragment><dt>Recognition</dt><dd>{w.honour}</dd></Fragment>}</dl>
  </Plate>

  <Part word="Brief">
    <p class="lead">{w.brief[0]}</p>
    {w.brief.slice(1).map((p) => <p>{p}</p>)}
    {w.site && <a class="cue" href={w.site[1]} target="_blank" rel="noopener">{w.site[0]} <span class="arr"></span></a>}
  </Part>

  {w.setting && (
    <Part word="Setting">
      {w.setting.text.map((x) => <p class="lead wide">{x}</p>)}
      <ul class="plain">{w.setting.facts.map(([k, v]) => <li><b>{k}</b><span>{v}</span></li>)}</ul>
      <p class="label">{w.setting.source}</p>
    </Part>
  )}

  {w.parts.map((p) => (
    <Part word={p.word}>
      <h2>{p.title}</h2>
      {p.text && <p>{p.text}</p>}
      {p.video && <figure class="case-video">
        <video controls playsinline muted={p.video.defaultMuted} preload="none" poster={`img/${p.video.poster}.webp`} width={p.video.width} height={p.video.height} aria-label={p.video.label} aria-describedby={`${w.id}-${p.word}-video-caption`}>
          <source src={`video/${p.video.src}.mp4`} type="video/mp4" />
          {p.video.captions && <track kind="captions" src={p.video.captions.src} srclang={p.video.captions.language} label={p.video.captions.label} />}
          <a href={`video/${p.video.src}.mp4`}>Watch {p.video.label}</a>
        </video>
        <figcaption id={`${w.id}-${p.word}-video-caption`}>
          {p.video.caption}
          {p.video.captions && <p>English automatic captions and <a href={p.video.captions.transcript}>plain text transcript (automatic)</a> from the <a href={p.video.captions.sourceURL}>official ETAP video</a>. Automatic wording may contain errors.</p>}
        </figcaption>
      </figure>}
      {p.steps && <div class="steps">{p.steps.map(([k, t]) => <div><h3>{k}</h3><p>{t}</p></div>)}</div>}
      {p.list && <ul class="plain">{p.list.map(([k, v]) => <li><b>{k}</b><span>{v}</span></li>)}</ul>}
      {p.sketch && <figure class="sketch"><Fragment set:html={p.sketch} />{p.caption && <figcaption>{p.caption}</figcaption>}</figure>}
      {p.code && (
        <div class="with-note">
          <div class="code"><header><b>{p.code.file}</b><span>{p.code.tag}</span></header><pre set:html={p.code.body} /></div>
          <Note dir="up">{p.code.note}</Note>
        </div>
      )}
      {p.shots && <div class={`shots n${Math.min(3, p.shots.length)}${p.shotsFullWidth ? ' full-width' : ''}`}>{p.shots.map(([s, c]) => <figure><div class="f"><Pic name={s} alt={c} sizes={p.shotsFullWidth ? '(max-width:820px) 92vw, 80vw' : '(max-width:820px) 92vw, 30vw'} /></div><figcaption>{c}</figcaption></figure>)}</div>}
      {p.quote && <figure class="said"><blockquote>“{p.quote[0]}”</blockquote><figcaption class="label">{p.quote[1]}</figcaption></figure>}
      {p.result && <p class="result" data-see><b>{p.result[0]}<Fragment set:html={ring} /></b><span>{p.result[1]}</span></p>}
    </Part>
  ))}

  {w.shots.length > 0 && (
    <Part word="Field">
      <div class={`shots n${w.shots.length}`}>{w.shots.map(([s, c]) => <figure><div class="f"><Pic name={s} alt={c} sizes="(max-width:820px) 92vw, 45vw" /></div><figcaption>{c}</figcaption></figure>)}</div>
    </Part>
  )}

  {w.after && (
    <Part word="After">
      <blockquote>{w.after}</blockquote>
      {w.afterNote && <Note dir="up" cls="inline">{w.afterNote}</Note>}
    </Part>
  )}

  <End label={ask[0]} path={ask[1]} kicker="Next work" next={[next.name, `work-${next.id}.html`]} />
</Base>

<style>
  .shots.full-width { grid-template-columns: minmax(0, 1fr); }
</style>
