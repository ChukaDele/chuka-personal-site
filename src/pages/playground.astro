---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import media from '../../docs/playground-media.json';
const [voxtell, rayna] = media;
---
<Base noindex>
  <div class="playground" data-playground>
    <header class="intro">
      <p class="label">Workshop / Draft</p>
      <h1>Playground<span>.</span></h1>
      <p class="opening">A little room to look, move and try things. Two new interaction studies, alongside selected motion from Rvysion.</p>
      <p class="label">Chuka Dele-Oyeleru · Strategy &amp; Operations</p>
    </header>

    <div class="studies">
      <section class="colour" aria-labelledby="colour-title">
        <p class="label">01 / Draft interaction study</p>
        <h2 id="colour-title">From ink to colour.</h2>
        <figure>
          <div class="reveal" data-reveal>
            <Pic name="jerome-mono" alt="Saint Jerome writing in his study, with a lion resting in the foreground." eager sizes="(min-width: 900px) 58vw, 100vw" />
            <div class="colour-layer" aria-hidden="true"><Pic name="jerome-tint" alt="" eager sizes="(min-width: 900px) 58vw, 100vw" /></div>
          </div>
          <figcaption>Albrecht Dürer, <cite>Saint Jerome in His Study</cite>, 1514. Public domain. Colour added.</figcaption>
        </figure>
        <p class="instruction">Move the dividing line to see the added colour. Half revealed to begin.</p>
        <div class="controls" data-controls hidden>
          <label for="colour-range">Colour revealed <output id="colour-output" for="colour-range">50%</output></label>
          <input id="colour-range" type="range" min="0" max="100" step="1" value="50" aria-controls="colour-output" />
          <button type="button" data-colour-reset>Reset colour</button>
        </div>
      </section>

      <section class="type-study" aria-labelledby="type-title">
        <p class="label">02 / Draft interaction study</p>
        <h2 id="type-title">Space to think.</h2>
        <div class="poster" data-poster>
          <p class="poster-note">Observation / structure</p>
          <p class="poster-words">Look.<br />Think.<br />Make.</p>
          <p class="poster-note">A study in typographic rhythm.</p>
        </div>
        <p class="instruction">Give the letters room. Change the ink.</p>
        <div class="controls" data-controls hidden>
          <label for="spacing-range">Letter spacing <output id="spacing-output" for="spacing-range">0.02 em</output></label>
          <input id="spacing-range" type="range" min="-0.02" max="0.12" step="0.01" value="0.02" aria-controls="spacing-output" />
          <div class="actions">
            <button type="button" data-ink-toggle aria-pressed="false">Copper ink</button>
            <button type="button" data-type-reset>Reset type</button>
          </div>
        </div>
      </section>

      <section class="motion voxtell" aria-labelledby="voxtell-title">
        <p class="label">03 / Studio motion</p>
        <h2 id="voxtell-title">Voxtell / Stay connected.</h2>
        <figure>
          <video controls playsinline muted preload="none" width={voxtell.width} height={voxtell.height} poster={voxtell.poster} aria-labelledby="voxtell-title" aria-describedby="voxtell-credit">
            <source src={voxtell.delivery} type="video/mp4" />
            <a href={voxtell.delivery}>Watch the Voxtell motion clip</a>
          </video>
          <figcaption id="voxtell-credit">Design &amp; motion: Rvysion studio. Strategy / project leadership: Chuka. <a href={voxtell.sourcePage}>Studio source ↗</a></figcaption>
        </figure>
      </section>

      <section class="motion rayna" aria-labelledby="rayna-title">
        <p class="label">04 / Studio motion</p>
        <h2 id="rayna-title">Rayna / Identity in motion.</h2>
        <figure>
          <video controls playsinline muted preload="none" width={rayna.width} height={rayna.height} poster={rayna.poster} aria-labelledby="rayna-title" aria-describedby="rayna-credit">
            <source src={rayna.delivery} type="video/mp4" />
            <a href={rayna.delivery}>Watch the Rayna motion clip</a>
          </video>
          <figcaption id="rayna-credit">Design &amp; motion: Rvysion studio. Internal-product strategy / operations: Chuka. <a href={rayna.sourcePage}>Studio source ↗</a></figcaption>
        </figure>
      </section>
    </div>
    <p class="closing">A working draft. <a href="work.html" data-name="Work">Back to selected work ↗</a></p>
  </div>
</Base>

<script>
  import { enhancePlayground } from '../scripts/playground.js';
  const root = document.querySelector('[data-playground]');
  if (root) {
    const sync = enhancePlayground(root);
    window.addEventListener('pageshow', sync);
  }
</script>

<style>
  .playground{max-width:1600px;margin:auto;padding:clamp(130px,14vw,200px) var(--gut) 64px}
  .intro{max-width:900px;margin-bottom:clamp(48px,8vw,120px)}
  h1{font-family:var(--display);font-size:clamp(76px,15vw,210px);font-weight:400;line-height:.95;margin:20px 0 28px}
  h1 span{color:var(--mark)}
  .opening{font-size:clamp(22px,2.4vw,32px);line-height:1.25;max-width:38ch;margin-bottom:20px}
  .studies{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:clamp(56px,8vw,120px) clamp(24px,4vw,64px);align-items:start}
  section{min-width:0}
  .colour{grid-column:1 / 8}
  .type-study{grid-column:9 / 13;margin-top:clamp(40px,12vw,180px)}
  .voxtell{grid-column:3 / 12}
  .rayna{grid-column:1 / -1}
  h2{font-size:clamp(24px,2.4vw,34px);font-weight:400;line-height:1.15;margin:8px 0 24px}
  .reveal{position:relative;--reveal:50%;background:var(--paper)}
  .reveal :global(img){width:100%;height:auto}
  .colour-layer{position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--reveal)) 0 0)}
  .poster{--spacing:.02em;background:var(--paper);color:var(--bg);padding:clamp(20px,3vw,44px);display:grid;gap:40px;color-scheme:light}
  .poster[data-copper="true"]{color:#8b3e25}
  .poster-words{font-family:var(--display);font-size:clamp(64px,7.2vw,110px);line-height:1.04;letter-spacing:var(--spacing);transition:color .18s var(--ease)}
  .poster-note{font-size:16px;line-height:1.25}
  figcaption{font-size:16px;line-height:1.4;color:var(--mute);margin-top:12px;max-width:76ch}
  figcaption a,.closing a{text-decoration:underline;text-underline-offset:.2em}
  .instruction{font-size:17px;margin-top:20px;max-width:44ch}
  .controls{display:grid;gap:8px;margin-top:16px;border-top:1px solid var(--line);padding-top:16px}
  label{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px}
  output{color:var(--mark);font-variant-numeric:tabular-nums}
  input{width:100%;min-width:0;min-height:44px;margin:0;accent-color:var(--mark);cursor:ew-resize}
  button{min-height:44px;border:1px solid var(--line);padding:8px 14px;justify-self:start}
  button[aria-pressed="true"]{border-color:var(--mark);color:var(--mark)}
  .actions{display:flex;flex-wrap:wrap;gap:10px}
  video{display:block;width:100%;height:auto;object-fit:contain;background:var(--panel)}
  .closing{margin-top:clamp(56px,8vw,120px);color:var(--mute)}
  @media(max-width:899px){.studies{grid-template-columns:minmax(0,1fr)}.colour,.type-study,.voxtell,.rayna{grid-column:1}.type-study{margin-top:0;width:min(100%,440px);justify-self:end}.poster-words{font-size:clamp(70px,17vw,110px)}}
  @media(prefers-reduced-motion:reduce){.poster-words{transition:none}}
</style>
