---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import Part from '../components/Part.astro';
import Note from '../components/Note.astro';
import End from '../components/End.astro';
import { shelves } from '../data/library.js';
---
<Base title="Library · Chuka Dele-Oyeleru" current="Library">
  <Plate word="Library" still="pacioli" frame alt="Luca Pacioli’s De Divina Proportione, 1509, open at two geometric solids drawn after Leonardo." credit="Luca Pacioli, <i>De Divina Proportione</i>, 1509, with solids after Leonardo.">
    <p class="label">The commonplace</p>
    <h1>Ideas kept within reach.</h1>
    <p class="sub">A short shelf: books, talks, one podcast, one essayist. Handled, not displayed.</p>
    <Note slot="note" dir="right">a book on proportion.<br />Leonardo drew the solids</Note>
  </Plate>

  <Part word="Shelf">
    <div class="case" data-case>
      <div class="bookcase">
      {shelves.map(({name, volumes}) => (
        <div class="shelfrow">
          <ul class="shelf" aria-label={name}>
            {volumes.map(({id, kind, title, by, cloth, ink, h, t}) => (
              <li><a href={`library.html#${id}`} class="book" data-book aria-controls={id} aria-label={`${kind}: ${title}, ${by}`}
                style={`--h:${h};--t:${t};--fs:${Math.min(t * 0.44, (0.66 * h) / (title.length * 0.4)).toFixed(1)};--cloth:${cloth};--ink:${ink}`}>
                <span class="spine" aria-hidden="true"><i class="kind">{kind}</i><b>{title}</b><i class="by">{by.split('.')[0].split(' with ')[0]}</i></span>
                <span class="cover" aria-hidden="true"><i class="kind">{kind}</i><b>{title}</b><i class="by">{by}</i></span>
                <span class="back"></span>
                <span class="leaves"></span>
              </a></li>
            ))}
          </ul>
          <div class="board"><span>{name}</span></div>
        </div>
      ))}
      </div>
      <div data-library-home>
        <div class="pulled" data-library-idle hidden>
          <p class="label">Pull one out</p>
          <h2>Eight volumes, two shelves.</h2>
          <p>Pick a spine and it comes off the shelf.</p>
        </div>
        {shelves.flatMap(shelf => shelf.volumes).map(volume => (
          <article class="pulled library-note" id={volume.id} data-library-note aria-labelledby={`${volume.id}-title`}>
            <p class="label">{volume.kind}</p>
            <h2 id={`${volume.id}-title`} tabindex="-1">{volume.title}</h2>
            <p>{volume.by}</p>
            <div class="note why">{volume.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
            <blockquote class="q" cite={volume.quote.source}>
              <p>“{volume.quote.text}”</p>
              <footer><a href={volume.quote.source} title={volume.quote.edition} aria-label={volume.quote.edition ? `${volume.quote.locator}, ${volume.quote.edition}` : undefined} target="_blank" rel="noopener">{volume.quote.locator}</a></footer>
            </blockquote>
            <a class="btn fill" href={volume.href} target="_blank" rel="noopener">{({Book: 'Find the book', Talk: 'Watch it', Podcast: 'Listen', Essays: 'Read the essays'})[volume.kind]} <span class="arr" aria-hidden="true"></span></a>
            <button type="button" class="cue back-btn" data-pback hidden>Put it back</button>
          </article>
        ))}
      </div>
      <dialog class="library-drawer" data-library-drawer aria-label="Library note">
        <button type="button" class="cue library-close" data-library-close autofocus>Close note</button>
        <div class="library-reading" data-library-reading></div>
      </dialog>
    </div>
  </Part>

  <End label="Recommend something" next={['Notes', 'notes.html']} />
</Base>
