---
import '../styles/global.css';
import { site } from '../data/site.js';
import fs from 'node:fs';
import { origin, pages, canonicalPath } from '../data/routes.js';
const path = canonicalPath(Astro.url.pathname);
const metadata = pages[path];
const { title, current = '', preload, description = metadata?.[0] || 'Chuka Dele-Oyeleru. Strategy and operations.' } = Astro.props;
const noindex = Astro.props.noindex || path === '/notes.html' || import.meta.env.ALLOW_INDEXING !== 'true';
const canonical = new URL(path, origin).href;
const socialImage = new URL(`/img/${metadata?.[1] || 'portrait-mono'}.webp`, origin).href;
const audio = fs.existsSync('public/audio') ? fs.readdirSync('public/audio').filter((f) => /\.(mp3|ogg|m4a|wav)$/.test(f)) : [];
const squiggle = ['M1 5 C 18 1, 34 8, 52 4 S 84 2, 99 5', 'M1 4 C 22 8, 40 1, 60 5 S 86 7, 99 3', 'M1 5 C 16 2, 38 7, 55 3 S 82 6, 99 4'];
---
<!doctype html>
<html lang="en" data-home={Astro.url.pathname.replace(/^\//, "").replace(/index(\.html)?$/, "") === "" ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <base href="/" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      try { var d = document.documentElement; if (sessionStorage.getItem('sheet') !== null) d.classList.add('arriving'); else if (!sessionStorage.getItem('seen') && d.hasAttribute('data-home')) d.classList.add('first'); } catch (e) {} setTimeout(function () { d.classList.remove('first', 'arriving'); }, 3500);
    </script>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/league-gothic-latin-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/alegreya-sans-latin-400-normal.woff2" crossorigin />
    {preload && <link rel="preload" as="image" href={preload} media="(min-width:821px)" fetchpriority="high" />}
    {preload && <link rel="preload" as="image" href={preload.replace(".webp", "-900.webp")} media="(max-width:820px)" fetchpriority="high" />}
    <meta name="theme-color" content="#1b1917" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {metadata && <link rel="canonical" href={canonical} />}
  </head>
  <body data-audio={JSON.stringify(audio)} data-mail={site.email}>
    <div class="sheet" id="sheet" aria-hidden="true" data-sign={site.greeting}><div class="flat"></div><canvas></canvas><p><span class="ink"><span class="w"></span><svg class="swash" viewBox="0 0 100 14" preserveAspectRatio="none"><path pathLength="1" d="M99 5 C 74 12, 36 1, 2 9" /></svg><svg class="quill" viewBox="0 0 120 240"><path class="v" d="M24 207 C 26 160, 50 84, 109 6 C 116 62, 100 132, 60 186 C 50 198, 38 206, 24 207 Z" /><path class="n" d="M48 150 l-9 -3 M58 128 l-11 -2 M70 102 l-12 0 M84 74 l-12 2 M96 48 l-10 3 M66 176 l-3 -11 M80 156 l-2 -12 M92 130 l0 -12 M102 100 l1 -11" /><path class="s" d="M10 232 L 24 207 C 46 150, 76 72, 109 6" /><path class="t" d="M10 232 L 19 213 L 27 218 Z" /></svg></span></p></div>
    <header class="top">
      <a class="name" href="index.html" data-name="Home">{site.name}</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav aria-label="Site" id="site-nav">
        {site.nav.map(([label, href], i) => (
          <a class="ul" href={href} data-name={label} aria-current={current === label ? 'page' : undefined}>{label}<svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d={squiggle[i % 3]} /></svg></a>
        ))}
        <button type="button" class="menu-letter" data-letter="hello">Write to me <span class="arr"></span></button>
        {audio.length > 0 && <button type="button" class="snd" id="snd" aria-pressed="false">Sound off</button>}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <nav aria-label="All pages">{site.all.map(([label, href]) => <a href={href} data-name={label}>{label}</a>)}<a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></nav>
      <p>© 2026 {site.name}. Artworks are in the public domain.</p>
    </footer>
    <dialog class="letter" id="letter" data-mail={site.email} data-endpoint={site.formEndpoint || undefined} aria-labelledby="letter-h">
      <form method="dialog" novalidate>
        <button type="button" class="x" data-close aria-label="Close">Close</button>
        <div data-compose>
          <p class="hand" id="letter-h">Dear Chuka,</p>
          <fieldset class="who"><legend>I am writing because</legend>
            <label><input type="radio" name="path" value="hiring" /><span>I am hiring</span></label>
            <label><input type="radio" name="path" value="project" /><span>something needs building</span></label>
            <label><input type="radio" name="path" value="press" /><span>I have a speaking or press request</span></label>
            <label><input type="radio" name="path" value="hello" /><span>I wanted to say hello</span></label>
          </fieldset>
          <div class="fields" data-fields></div>
          <label class="line"><span>Signed</span><input name="name" autocomplete="name" autocapitalize="words" enterkeyhint="next" placeholder="your name" required aria-describedby="err-name" /><em class="err" id="err-name" role="alert" data-err="name"></em></label>
          <label class="line"><span>Where I should reply</span><input name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@company.com" autocapitalize="off" spellcheck="false" enterkeyhint="next" required aria-describedby="err-email" /><em class="err" id="err-email" role="alert" data-err="email"></em></label>
          <div class="line"><label for="letter-tel"><span>A number, if you would rather talk (optional)</span></label>
            <div class="tel"><input type="hidden" name="country" value="GB" /><button type="button" class="cc" data-cc aria-haspopup="listbox" aria-expanded="false" aria-controls="cc-list" aria-label="Country calling code: United Kingdom, +44"><span class="flag" data-cc-flag aria-hidden="true">🇬🇧</span><span data-cc-code>+44</span></button><input id="letter-tel" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="phone number" enterkeyhint="send" aria-describedby="err-phone" /></div>
            <div class="cc-pop" data-cc-pop hidden><input type="search" class="cc-q" data-cc-q placeholder="Search a country or code" aria-label="Search a country or code" role="combobox" aria-expanded="true" aria-controls="cc-list" aria-autocomplete="list" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="done" /><ul id="cc-list" role="listbox" aria-label="Countries" data-cc-list></ul></div><em class="err" id="err-phone" role="alert" data-err="phone"></em></div>
          <p class="next-step" data-next></p>
          <div class="btns"><button type="submit" class="btn fill ink-btn"><span data-send>Send it</span> <span class="arr"></span></button><button type="button" class="x2" data-copy>or copy the letter</button></div>
          <p class="small" data-how role="status"></p>
        </div>
        <div class="sent" data-sent hidden tabindex="-1" role="status">
          <p class="hand" data-thanks>Thank you.</p>
          <p class="hand small-hand" data-sent-line></p>
          <p class="hand small-hand">I will reply within 24 hours.</p>
          <p class="hand sign">Chuka</p>
          <div class="btns"><button type="button" class="btn fill ink-btn" data-close>Close <span class="arr"></span></button></div>
        </div>
      </form>
    </dialog>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
